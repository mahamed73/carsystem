# ------------------------------------------------------------------
# إعدادات التطوير المحلي — انسخ الملف ده لـ .env وعدّل القيم
# ------------------------------------------------------------------

# رابط قاعدة بيانات PostgreSQL
DATABASE_URL=postgresql://car_app:car_app_pw@localhost:5432/carsystem

# مفتاح تشفير الجلسات — ولّد واحد جديد بالأمر:
#   openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me-in-production-please-32chars

# رابط الموقع (مهم في الإنتاج)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# بيانات مدير النظام الافتراضي (تُستخدم عند تشغيل scripts/seed.js)
ADMIN_NAME=مدير النظام
ADMIN_EMAIL=admin@carsystem.local
ADMIN_PASSWORD=Admin@12345

# اسم الورشة اللي يظهر في الموقع
NEXT_PUBLIC_WORKSHOP_NAME=مركز الصيانة الذكي
