# =====================================================================
#  إعدادات النشر على VPS — انسخ الملف ده لـ .env.docker وعدّل القيم
#     cp .env.docker.example .env.docker
#     nano .env.docker
# =====================================================================

# ---------- الدومين و SSL ----------
# اكتب الدومين بدون https://  (لازم سجل A يشاور على IP السيرفر)
DOMAIN=carsys.easychat.cloud
# بريدك — تستخدمه Let's Encrypt للتنبيهات لو الشهادة هتنتهي
ACME_EMAIL=admin@easychat.cloud

# ---------- قاعدة البيانات ----------
POSTGRES_USER=carapp
# ⚠️ غيّرها لكلمة مرور قوية:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=carsystem

# ---------- التطبيق ----------
# ⚠️ مهم جداً — ولّد مفتاحك بالأمر:  openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=https://carsys.easychat.cloud
NEXTAUTH_URL=https://carsys.easychat.cloud

# اسم الورشة الظاهر في الموقع
NEXT_PUBLIC_WORKSHOP_NAME=مركز الصيانة الذكي

# ---------- حساب المدير الافتراضي (يُنشأ مرة واحدة عند أول تشغيل) ----------
ADMIN_NAME=مدير النظام
ADMIN_EMAIL=admin@easychat.cloud
# ⚠️ غيّرها فوراً بعد أول تسجيل دخول
ADMIN_PASSWORD=ChangeMe@12345

# ---------- خيارات تشغيل ----------
# true = إدخال الخدمات والمدير تلقائياً عند تشغيل الحاوية
SEED_ON_START=true
# true = إدخال بيانات تجريبية (عملاء وسيارات وحجوزات) — للعرض فقط
SEED_DEMO=false

# ---------- المنطقة الزمنية ----------
TZ=Africa/Cairo
